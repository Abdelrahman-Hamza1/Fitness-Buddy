        "name": "settings_kv_outbox_au",
        "sql": "CREATE TRIGGER settings_kv_outbox_au AFTER UPDATE ON settings_kv\nWHEN NEW.updated_hlc IS NOT OLD.updated_hlc\n  AND (SELECT value FROM sync_state WHERE \"key\" = 'outbox.capture') IS NOT '0'\nBEGIN\n  INSERT INTO sync_outbox (entity, row_id, hlc, deleted)\n  VALUES ('setting', NEW.id, NEW.updated_hlc, NEW.deleted_at IS NOT NULL);\nEND;"
      }
