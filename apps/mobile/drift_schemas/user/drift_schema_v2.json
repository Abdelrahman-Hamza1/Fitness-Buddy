        "name": "settings_kv_outbox_ai",
        "sql": "CREATE TRIGGER settings_kv_outbox_ai AFTER INSERT ON settings_kv\nWHEN (SELECT value FROM sync_state WHERE \"key\" = 'outbox.capture') IS NOT '0'\nBEGIN\n  INSERT INTO sync_outbox (entity, row_id, hlc, deleted)\n  VALUES ('setting', NEW.id, NEW.updated_hlc, NEW.deleted_at IS NOT NULL);\nEND;"
      }
    },
