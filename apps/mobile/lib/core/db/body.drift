-- The weigh-ins' index (A14 D7). Partial on live rows: every read query
-- includes deleted_at IS NULL, so the planner can use it.
import 'tables/body_tables.dart';

-- The live list in date and time order, and a day's weigh-ins (D3).
CREATE INDEX ix_weigh_ins_live ON weigh_ins (local_date, measured_at_utc)
  WHERE deleted_at IS NULL;
