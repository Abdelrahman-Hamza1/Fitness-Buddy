<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The API (/v1/config, later sync and Buddy). The template only grants it to
         debug and profile builds. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Hardening (S06 plan A8, backlog #32):
         - app_name comes from the flavor (resValue in app/build.gradle.kts).
         - network_security_config: no cleartext HTTP. Only the dev flavor overrides
           it (src/dev/res/xml) to reach the local API on 127.0.0.1 over adb reverse.
           Never set android:usesCleartextTraffic; tools/scripts/apk_hardening_check.py
           fails a release build that allows cleartext or is debuggable.
         - Backup: the install's device id (shared_preferences key fb.device_id) must
           not be restored onto another install or device, or two installs would
           share one id (X-Device-Id, and the sync clock's node id from A01).
           SharedPreferencesAsync stores it with DataStore in
           files/datastore/FlutterSharedPreferences.preferences_pb, the legacy API
           in shared_prefs/. Both are excluded from cloud backup and device
           transfer (Android 12+: data_extraction_rules; Android 8-11:
           backup_rules; keep the two files in sync).
         - A11 PA5: Android 12+ backs up only files/profiles/local/user.db
           and its -wal/-shm, with E2EE cloud capability required. Other files,
           photos, credentials, device identity and catalog remain excluded.
           Android 8-11 and cross-platform transfers exclude every domain. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- Dart's enableNativeCrashHandling does not disable the NDK handler. -->
        <meta-data android:name="io.sentry.ndk.enable" android:value="false"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
