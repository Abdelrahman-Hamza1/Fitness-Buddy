<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The API (/v1/config, later sync and Buddy). The template only grants it to
         debug and profile builds. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- A50: androidx.credentials pulls androidx.biometric, which asks for these.
         Google sign-in (GetSignInWithGoogleOption) doesn't use them;
         tools/scripts/apk_hardening_check.py fails a release that has them. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove"/>
    <!-- A28a D13: mobile_scanner's manifest adds android.permission.CAMERA (asked at
         first use by the barcode scanner; denied = "Type the code") and
         android.hardware.camera with required="false". Barcode decoding runs on the
         phone (bundled ML Kit model); no image leaves it. -->
    <!-- A40 D7: local reminders. flutter_local_notifications' manifest adds
         POST_NOTIFICATIONS (asked once in context, A40 D8) and VIBRATE. Reminders are
         rescheduled after a reboot or an app update (the boot receiver below), so
         RECEIVE_BOOT_COMPLETED. Every reminder is inexact: no SCHEDULE_EXACT_ALARM or
         USE_EXACT_ALARM (tools/scripts/apk_hardening_check.py fails a release that
         asks for one). Nothing leaves the phone (TD-013). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- A70 D1-D2: voice input in Buddy (AI-014, D-101). speech_to_text hands the
         microphone to the phone's own speech recogniser (on-device first); the app
         records no audio file and sends no audio anywhere. Asked at first use,
         after a plain explanation; denied = the keyboard. No BLUETOOTH_CONNECT
         (initialized with noBluetooth). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Hardening (S06 plan A8, backlog #32):
         - app_name comes from the flavor (resValue in app/build.gradle.kts).
         - network_security_config: no cleartext HTTP. Only the dev flavor overrides
           it (src/dev/res/xml) to reach the local API on 127.0.0.1 over adb reverse.
           Never set android:usesCleartextTraffic; tools/scripts/apk_hardening_check.py
           fails a release build that allows cleartext or is debuggable.
         - Backup: the install's device id (shared_preferences key fb.device_id) must
           not be restored onto another install or device, or two installs would
           share one id (X-Device-Id, and the sync clock's node id from A01).
           SharedPreferencesAsync stores it with DataStore in
           files/datastore/FlutterSharedPreferences.preferences_pb, the legacy API
           in shared_prefs/. Both are excluded from cloud backup and device
           transfer (Android 12+: data_extraction_rules; Android 8-11:
           backup_rules; keep the two files in sync).
         - A11 PA5: Android 12+ backs up only files/profiles/local/user.db
           and its -wal/-shm, with E2EE cloud capability required. Other files,
           photos, credentials, device identity and catalog remain excluded.
           Android 8-11 and cross-platform transfers exclude every domain. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- Dart's enableNativeCrashHandling does not disable the NDK handler. -->
        <meta-data android:name="io.sentry.ndk.enable" android:value="false"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- A40 D7: flutter_local_notifications shows scheduled reminders and
             restores them after a reboot or an update. Not exported. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- A71 (UX-082): the three home-screen widgets (HomeWidgets.kt). The launcher
             delivers APPWIDGET_UPDATE, so the receivers must be exported, with that
             filter only; AppWidgetProvider ignores other actions, so another app can at
             most cause a redraw. Taps open
             MainActivity through explicit, immutable PendingIntents with a fixed
             action (no intent filter, no deep link). The snapshot they draw lives in
             shared_prefs/fb_home_widget.xml, excluded from backup and transfer by the
             rules above (sharedpref is excluded / not on the allow-list). -->
        <receiver
            android:name=".TodayWidgetMedium"
            android:exported="true"
            android:label="@string/widget_medium_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_medium_info"/>
        </receiver>
        <receiver
            android:name=".TodayWidgetNumbers"
            android:exported="true"
            android:label="@string/widget_numbers_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_numbers_info"/>
        </receiver>
        <receiver
            android:name=".TodayWidgetButtons"
            android:exported="true"
            android:label="@string/widget_buttons_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_buttons_info"/>
        </receiver>
        <!-- A71 review: the midnight redraw alarm (explicit, ours) and the system's time
             and time-zone changes (implicit-broadcast exceptions) redraw the widgets.
             Not exported: no other app can reach it. -->
        <receiver
            android:name=".TodayWidgetClock"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- A70 D2: Android 11+ package visibility, so the speech recogniser
             service can be found (SpeechRecognizer.isRecognitionAvailable). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
