<?xml version="1.0" encoding="utf-8"?>
<!-- A11 PA5: include rules form an allow-list across domains. Only the current
     local profile database and its SQLite sidecars may leave the device.
     The raw DB includes historical install IDs and sync bookkeeping.
     Active install-id preferences and credentials are excluded; a new install
     creates a fresh active ID while retaining historical authorship (Q2).
     Never include profiles/ (future photos).
     A33 must explicitly review any new profile path. Lint rejects excludes of
     paths that no include covers (an include list already leaves everything
     else out), so none are written. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="profiles/local/user.db" />
        <include domain="file" path="profiles/local/user.db-wal" />
        <include domain="file" path="profiles/local/user.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="profiles/local/user.db" />
        <include domain="file" path="profiles/local/user.db-wal" />
        <include domain="file" path="profiles/local/user.db-shm" />
    </device-transfer>
    <cross-platform-transfer platform="ios">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cross-platform-transfer>
</data-extraction-rules>
