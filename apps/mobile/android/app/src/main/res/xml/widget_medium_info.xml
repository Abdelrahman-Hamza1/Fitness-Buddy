<?xml version="1.0" encoding="utf-8"?>
<!-- A71 D9 (UX-082), A73 D4: the medium 4 x 2 widget. No periodic update (updatePeriodMillis 0): the app
     redraws on every change and HomeWidgets.kt arms one inexact alarm for the next midnight.
     Layouts per size (WidgetSizing.kt, dp): MEDIUM_ROW 280 x 72 (4 x 1), MEDIUM_REGULAR 280 x 136, MEDIUM_LARGE 320 x 184.
     minResizeWidth/Height = the smallest of them (smallest on both axes, so every allowed size
     fits one; HomeWidgetSizingTest checks it); minWidth/Height = the regular one (the default
     span before Android 12). initialLayout and previewLayout are the regular layout. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_medium_description"
    android:initialLayout="@layout/widget_medium"
    android:minWidth="280dp"
    android:minHeight="136dp"
    android:minResizeWidth="280dp"
    android:minResizeHeight="72dp"
    android:previewImage="@drawable/widget_mark"
    android:previewLayout="@layout/widget_medium"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
