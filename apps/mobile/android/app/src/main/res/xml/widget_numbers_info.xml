<?xml version="1.0" encoding="utf-8"?>
<!-- A71 D9 (UX-082), A73 D4: the small 2 x 2 numbers widget. No periodic update (updatePeriodMillis 0): the app
     redraws on every change and HomeWidgets.kt arms one inexact alarm for the next midnight.
     Layouts per size (WidgetSizing.kt, dp): NUMBERS_ROW 110 x 64 (2 x 1), NUMBERS_ROW_LARGE 150 x 84, NUMBERS_REGULAR 110 x 120, NUMBERS_LARGE 150 x 170.
     minResizeWidth/Height = the smallest of them (smallest on both axes, so every allowed size
     fits one; HomeWidgetSizingTest checks it); minWidth/Height = the regular one (the default
     span before Android 12). initialLayout and previewLayout are the regular layout. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_numbers_description"
    android:initialLayout="@layout/widget_numbers"
    android:minWidth="110dp"
    android:minHeight="120dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="64dp"
    android:previewImage="@drawable/widget_mark"
    android:previewLayout="@layout/widget_numbers"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
