<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8-11 (Auto Backup): keeps the device id, the local databases
     (profiles/: user.db, -wal, -shm) and the catalog packs (catalog/) out of
     backups. Why, and where they are stored: AndroidManifest.xml. Same rules as
     data_extraction_rules.xml. -->
<full-backup-content>
    <!-- A20: plugin ciphertext, wrapped key, cipher config and commit counters. -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore/" />
    <exclude domain="file" path="profiles/" />
    <exclude domain="file" path="catalog/" />
</full-backup-content>
