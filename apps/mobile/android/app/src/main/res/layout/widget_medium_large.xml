<?xml version="1.0" encoding="utf-8"?>
<!-- A73 D1 (UX-082): the medium widget on large cells (variant MEDIUM_LARGE, 320 x 184 dp,
     a 4 x 2 on One UI): the regular layout, bigger. High: 14 + ring 96 + 12 + buttons 48 + 14 =
     184 (the text column: title ~20 + 2 x (10 + macro ~24) = 88 <= 96). Wide: 14 + ring 96 + 14 +
     two macro columns of 84 + 14 between + 14 = 320. Values keep their width, labels ellipsize:
     "~250/300" 12 sp ~54, worst "~1,250/300" ~67 <= 84. Ring: "~2,500" 23 sp bold ~75 and
     "kcal eaten" 12 sp ~54 inside 96 x 0.8 = 76.8.
     Widths: Roboto ~0.56 em per digit, "~" and "/", ~0.25 em for "," and "."; bold +5%.
     RemoteViews: only views the launcher can inflate; colours and words are
     resources, the numbers come from the app's snapshot (HomeWidgets.kt). The same
     view ids in every size, so one render path fills them (A73 D5). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="14dp">
    <FrameLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/numbers_block"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp">
                <ProgressBar
                    android:id="@+id/ring"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_ring" />
                <ProgressBar
                    android:id="@+id/ring_over"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progress="1000"
                    android:progressDrawable="@drawable/widget_ring_over"
                    android:visibility="gone" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/ring_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_on_surface"
                        android:textSize="23sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/ring_caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_today"
                        android:textAlignment="viewStart"
                        android:textColor="@color/widget_on_surface"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/eaten_of"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/widget_protein"
                                android:textAlignment="viewStart"
                                android:textColor="@color/widget_on_surface_variant"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/protein_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/widget_on_surface"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp">
                            <ProgressBar
                                android:id="@+id/protein_bar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:indeterminate="false"
                                android:max="1000"
                                android:maxHeight="6dp"
                                android:minHeight="6dp"
                                android:progressDrawable="@drawable/widget_bar_protein" />
                            <ProgressBar
                                android:id="@+id/protein_over"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:indeterminate="false"
                                android:max="1000"
                                android:maxHeight="6dp"
                                android:minHeight="6dp"
                                android:progress="1000"
                                android:progressDrawable="@drawable/widget_bar_over"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/widget_carbs"
                                android:textAlignment="viewStart"
                                android:textColor="@color/widget_on_surface_variant"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/carbs_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/widget_on_surface"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp">
                            <ProgressBar
                                android:id="@+id/carbs_bar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:indeterminate="false"
                                android:max="1000"
                                android:maxHeight="6dp"
                                android:minHeight="6dp"
                                android:progressDrawable="@drawable/widget_bar_carbs" />
                            <ProgressBar
                                android:id="@+id/carbs_over"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:indeterminate="false"
                                android:max="1000"
                                android:maxHeight="6dp"
                                android:minHeight="6dp"
                                android:progress="1000"
                                android:progressDrawable="@drawable/widget_bar_over"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/widget_fat"
                                android:textAlignment="viewStart"
                                android:textColor="@color/widget_on_surface_variant"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/fat_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/widget_on_surface"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp">
                            <ProgressBar
                                android:id="@+id/fat_bar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:indeterminate="false"
                                android:max="1000"
                                android:maxHeight="6dp"
                                android:minHeight="6dp"
                                android:progressDrawable="@drawable/widget_bar_fat" />
                            <ProgressBar
                                android:id="@+id/fat_over"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:indeterminate="false"
                                android:max="1000"
                                android:maxHeight="6dp"
                                android:minHeight="6dp"
                                android:progress="1000"
                                android:progressDrawable="@drawable/widget_bar_over"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/widget_fiber"
                                android:textAlignment="viewStart"
                                android:textColor="@color/widget_on_surface_variant"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/fiber_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/widget_on_surface"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp">
                            <ProgressBar
                                android:id="@+id/fiber_bar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:indeterminate="false"
                                android:max="1000"
                                android:maxHeight="6dp"
                                android:minHeight="6dp"
                                android:progressDrawable="@drawable/widget_bar_fiber" />
                            <ProgressBar
                                android:id="@+id/fiber_over"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:indeterminate="false"
                                android:max="1000"
                                android:maxHeight="6dp"
                                android:minHeight="6dp"
                                android:progress="1000"
                                android:progressDrawable="@drawable/widget_bar_over"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/plain_block"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_mark" />
            <TextView
                android:id="@+id/plain_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_open_app"
                android:textColor="@color/widget_on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/button_speak"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_filled"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_speak"
                android:tint="@color/widget_on_brand" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_speak"
                android:textColor="@color/widget_on_brand"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/button_ask"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_button_tonal"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_ask"
                android:tint="@color/widget_on_tonal" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_ask"
                android:textColor="@color/widget_on_tonal"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/button_weigh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_button_tonal"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_weigh"
                android:tint="@color/widget_on_tonal" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_weigh"
                android:textColor="@color/widget_on_tonal"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
