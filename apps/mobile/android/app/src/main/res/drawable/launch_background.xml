<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window on API 26-30 (A44 D12): the dark window colour with
     the reversed Embrace mark in the middle. Android 12+ uses the system
     splash (values-v31/styles.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/fb_window_background" />
    <item
        android:width="160dp"
        android:height="160dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
