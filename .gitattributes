# Normalise line endings: LF in the repo and in working trees.
* text=auto eol=lf
*.sh text eol=lf
Makefile text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: no diff, no EOL conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.jks binary
*.keystore binary
*.pdf binary
*.zip binary
*.gz binary
*.xz binary

# Generated files: collapsed in GitHub diffs.
pubspec.lock linguist-generated=true

# The bundled API contract (make gen-contract).
contracts/openapi.yaml linguist-generated=true

# The generated Dart API client and the generator fixture's output (make gen-dart).
packages/fb_api_client/lib/src/generated/** linguist-generated=true
packages/fb_api_client/test/generated/** linguist-generated=true
# The app's gen-l10n and Riverpod output (make gen-app).
apps/mobile/lib/l10n/gen/** linguist-generated=true
apps/mobile/lib/**/*.g.dart linguist-generated=true
