# Normalise line endings: LF in the repo and in working trees.
* text=auto eol=lf
*.sh text eol=lf
Makefile text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: no diff, no EOL conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.jks binary
*.keystore binary
*.pdf binary
*.zip binary
*.gz binary
*.xz binary

# Generated files: collapsed in GitHub diffs.
pubspec.lock linguist-generated=true
