# https://editorconfig.org — shared editor settings for the whole monorepo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.sh]
indent_size = 2

# Recipes must be indented with tabs.
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

# .NET (C#, MSBuild, .slnx) settings are added by S01 WP4 below this line.

[*.cs]
indent_size = 4

# Enforced in the build (EnforceCodeStyleInBuild + TreatWarningsAsErrors, S01 D12):
# a warning here fails `make check-dotnet`. Everything else keeps the .NET defaults.

# File-scoped namespaces.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# `using` directives outside the namespace.
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0065.severity = warning

# Unnecessary `using` directives.
dotnet_diagnostic.IDE0005.severity = warning

# Formatting (indentation, spacing, new lines).
dotnet_diagnostic.IDE0055.severity = warning

# Test names use underscores (`Subject_does_something`, see 10 §5).
[backend/tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
