{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fitnessbuddy.local/schema/usda_selection.v1.schema.json",
  "title": "Fitness Buddy USDA basics selection (A03)",
  "description": "data/usda_selection.yaml: the curated basics. Catalog ID usda:<slug> (A03 D4); the nutrients come from data/usda/extract.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": ["foods"],
  "properties": {
    "foods": { "type": "array", "items": { "$ref": "#/definitions/food" } }
  },
  "definitions": {
    "text": { "type": "string", "pattern": "\\S" },
    "nameList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/text" }
    },
    "food": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fdc_id", "state", "names"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^usda:(?!\\d+$)[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "fdc_id": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["raw", "cooked", "dry", "drained", "fried", "as_sold"] },
        "yield_group": { "$ref": "#/definitions/text" },
        "fiber_zero": { "type": "boolean" },
        "names": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en"],
          "properties": {
            "en": { "$ref": "#/definitions/nameList" },
            "ar": { "$ref": "#/definitions/nameList" },
            "arabizi": { "$ref": "#/definitions/nameList" }
          }
        },
        "servings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit", "g"],
            "properties": {
              "unit": { "$ref": "#/definitions/text" },
              "g": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "sanity_override": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": { "reason": { "$ref": "#/definitions/text" } }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
