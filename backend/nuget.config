<?xml version="1.0" encoding="utf-8"?>
<!-- One package source, so restores are reproducible and can't be hijacked by a
     machine-level feed (S01 D6). Every package ID maps to nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
