<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <!-- Lowest shared layer (04 §3.3). Two namespaces in one project (S03 plan D13):
       FitnessBuddy.BuildingBlocks.* is plain .NET (no ASP.NET Core, an architecture rule enforces it);
       FitnessBuddy.BuildingBlocks.Web.* holds the HTTP pieces modules share. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Cronos" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FitnessBuddy.Persistence.Tests" />
  </ItemGroup>
</Project>
