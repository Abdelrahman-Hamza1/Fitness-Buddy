{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Clients": {
    "MinimumAppVersion": "0.1.0"
  },
  "Account": {
    "ClientConfig": {
      "FeatureFlags": {},
      "Thresholds": {}
    }
  },
  "FeatureFlags": {},
