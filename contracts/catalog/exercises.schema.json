{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fitnessbuddy.local/catalog/exercises.schema.json",
  "title": "Catalog load file: exercises.jsonl",
  "description": "A catalogued exercise (WO-001/002/004). Equipment variants are separate entries; type selects the per-set fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name_en",
    "type",
    "equipment",
    "primary_muscle",
    "secondary_muscles",
    "catalog_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ex:[a-z0-9_]+$",
      "maxLength": 64
    },
    "name_en": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "weight_reps",
        "bodyweight_reps",
        "assisted",
        "reps_only",
        "duration",
        "distance_duration"
      ]
    },
    "equipment": {
      "enum": [
        "barbell",
        "dumbbell",
        "machine",
        "cable",
        "bodyweight",
        "kettlebell",
        "band",
        "other"
      ]
    },
    "primary_muscle": {
      "type": "string",
      "minLength": 1
    },
    "secondary_muscles": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+$"
      }
    },
    "catalog_version": {
      "type": "integer",
      "minimum": 0
    }
  }
}
