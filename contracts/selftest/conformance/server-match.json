{
  "openapi": "3.1.1",
  "info": {
    "title": "FitnessBuddy.Host | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/config": {
      "get": {
        "tags": [
          "Config"
        ],
        "operationId": "getConfig",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppConfig"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppConfig": {
        "required": [
          "minimumAppVersion",
          "featureFlags",
          "thresholds"
        ],
        "type": "object",
        "properties": {
          "minimumAppVersion": {
            "type": "string"
          },
          "featureFlags": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "thresholds": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "description": "Client configuration."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Config"
    }
  ]
}
